@startuml sequence-inscription
title Inscription — POST /api/v1/auth/register
' Scénario réel : AuthController.register + UserService + JwtUtil

autonumber
skinparam shadowing false
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F8FAFC
}

actor "Client (SPA)" as C
participant "AuthController" as AC
participant "UserService" as US
participant "UserRepository" as UR
participant "PasswordEncoder" as PE
participant "JwtUtil" as JU
database "PostgreSQL" as DB

C -> AC : POST /api/v1/auth/register\n{ name, email, password }
activate AC
AC -> US : getUserByEmail(email)
activate US
US -> UR : findByEmail(email)
activate UR
UR -> DB : SELECT ... WHERE email = ?
DB --> UR : 0 ou 1 ligne
UR --> US : Optional<User>
deactivate UR
US --> AC : Optional<User>
deactivate US

alt Email déjà utilisé
  AC --> C : 409 Conflict\n{ error: { code: "conflict", ... } }
else Email disponible
  AC -> PE : encode(password)
  activate PE
  PE --> AC : hash BCrypt
  deactivate PE

  AC -> US : saveUser(user)\n(role = USER)
  activate US
  US -> UR : save(user)
  activate UR
  UR -> DB : INSERT INTO users
  DB --> UR : ligne créée
  UR --> US : User
  deactivate UR
  US --> AC : User
  deactivate US

  AC -> JU : generateToken(email)
  activate JU
  JU --> AC : JWT (HS256, durée 2 h)
  deactivate JU

  AC --> C : 201 Created\n{ token, type: "Bearer" }
end

note right of AC
  Le frontend n'enregistre PAS le token
  après l'inscription (seul login le fait) :
  le garde de route considère l'utilisateur
  comme non connecté. Anomalie frontend.
end note

deactivate AC
@enduml
